{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.mjs", "tests/**/*.mjs", "scripts/audit/*.mjs", "scripts/lockbox-open.mjs", "scripts/update-pdfjs.mjs"],
  "exclude": ["src/vendor"]
}
